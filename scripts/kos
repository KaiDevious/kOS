#!/bin/bash
# kOS — umbrella command. Dispatches to the kOS tools.
#   sudo kos setup                 apply the full kOS look + system tweaks
#   kos theme <name>               lamplight | liquidglass | dark | light
#   kos themes                     list available themes
#   kos version
VERSION="1.0.2"
cmd="${1:-help}"; [ $# -gt 0 ] && shift

case "$cmd" in
  setup)
    if command -v kos-setup >/dev/null 2>&1; then exec kos-setup "$@"
    else echo "kos: setup not installed (reinstall kos-desktop)"; exit 1; fi ;;
  theme)
    if command -v kos-theme >/dev/null 2>&1; then exec kos-theme "$@"
    else echo "kos: themes not installed yet — run 'sudo kos setup' first"; exit 1; fi ;;
  themes)
    echo "kOS themes:  lamplight  liquidglass  dark  light"
    echo "apply with:  kos theme <name>" ;;
  version|-v|--version)
    echo "kOS $VERSION" ;;
  help|-h|--help)
    cat <<H
kOS $VERSION — usage:
  sudo kos setup            apply the full kOS look + system tweaks
  kos theme <name>          switch desktop look live:
                              lamplight    warm, lamplit
                              liquidglass  cool frosted gray
                              dark         kOS dark
                              light        kOS light
  kos themes                list the themes
  kos version               show version
H
    ;;
  *)
    echo "kos: unknown command '$cmd'  (try: kos help)"; exit 1 ;;
esac
