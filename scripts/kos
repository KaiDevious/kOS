#!/bin/bash
# kOS — umbrella command. Dispatches to the kOS tools.
# report the real installed package version (falls back if dpkg can't say)
VERSION="$(dpkg-query -W -f='${Version}' kos-desktop 2>/dev/null)"
[ -n "$VERSION" ] || VERSION="1.3.2"
CODE="$(cat /usr/share/kos/codename 2>/dev/null)"
SITE="https://kaidevious.github.io/kOS/"
REPO="https://github.com/KaiDevious/kOS"
WP=/usr/share/wallpapers/kOS
STATE="${XDG_CACHE_HOME:-$HOME/.cache}/kos/theme"
THEME_ORDER="lamplight liquidglass dark light"

accent_rgb(){ case "$1" in
  amber)  echo 217,154,78 ;;  slate) echo 154,161,173 ;;
  blue)   echo 74,134,240 ;;  green) echo 46,204,113 ;;
  purple) echo 155,89,182 ;;  red)   echo 231,76,60 ;;
  *) echo "" ;; esac; }

cmd="${1:-help}"; [ $# -gt 0 ] && shift

case "$cmd" in
  setup)
    if command -v kos-setup >/dev/null 2>&1; then exec kos-setup "$@"
    else echo "kos: setup not installed (reinstall kos-desktop)"; exit 1; fi ;;

  theme)
    if command -v kos-theme >/dev/null 2>&1; then
      [ -n "$1" ] && { mkdir -p "$(dirname "$STATE")"; printf '%s\n' "$1" > "$STATE" 2>/dev/null || true; }
      exec kos-theme "$@"
    else echo "kos: themes not installed yet — run 'sudo kos setup' first"; exit 1; fi ;;

  next)
    cur="$(cat "$STATE" 2>/dev/null)"; nextt=""; found=0
    for t in $THEME_ORDER; do
      [ "$found" = 1 ] && { nextt="$t"; break; }
      [ "$t" = "$cur" ] && found=1
    done
    [ -n "$nextt" ] || nextt="lamplight"
    mkdir -p "$(dirname "$STATE")"; printf '%s\n' "$nextt" > "$STATE" 2>/dev/null || true
    exec kos-theme "$nextt" ;;

  themes)
    echo "kOS themes:  lamplight  liquidglass  dark  light"
    echo "apply with:  kos theme <name>   ·   cycle with:  kos next" ;;

  wallpaper|wp)
    case "${1:-}" in
      lamplight|warm)    f="$WP/kos-lamplight.png" ;;
      liquidglass|glass) f="$WP/kos-liquidglass.png" ;;
      dark)              f="$WP/kos-dark.png" ;;
      light)             f="$WP/kos-light.png" ;;
      *) echo "usage: kos wallpaper lamplight|liquidglass|dark|light"; exit 1 ;;
    esac
    if command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
      plasma-apply-wallpaperimage "$f" >/dev/null 2>&1 && echo "wallpaper -> $1"
    else echo "kos: plasma-apply-wallpaperimage not found"; exit 1; fi ;;

  accent)
    a="${1:-}"
    if [ "$a" = "random" ]; then
      set -- amber slate blue green purple red
      a="$(eval echo \${$(( RANDOM % 6 + 1 ))})"
    fi
    rgb="$(accent_rgb "$a")"
    [ -n "$rgb" ] || { echo "usage: kos accent amber|slate|blue|green|purple|red|random"; exit 1; }
    KW="$(command -v kwriteconfig6 || command -v kwriteconfig5 || true)"
    [ -n "$KW" ] && "$KW" --file kdeglobals --group General --key AccentColor "$rgb" 2>/dev/null
    echo "accent -> $a" ;;

  notify)
    msg="$*"; [ -n "$msg" ] || msg="Hello from kOS"
    if command -v notify-send >/dev/null 2>&1; then
      notify-send -a kOS -i io.github.kaidevious.kOS "kOS" "$msg"
    else echo "kos: notify-send not found"; exit 1; fi ;;

  matrix)
    if command -v cmatrix >/dev/null 2>&1; then exec cmatrix -ab -C green
    else echo "kos: cmatrix not installed — run 'sudo kos setup'"; exit 1; fi ;;

  party)
    trap 'printf "\033[0m\n"; exit 0' INT
    s="   k O S   I S   G R E A T   "
    for n in $(seq 1 60); do
      out=""; i=0
      while [ $i -lt ${#s} ]; do
        ch="${s:$i:1}"; case $(( (i + n) % 6 )) in
          0) c=196;; 1) c=208;; 2) c=226;; 3) c=46;; 4) c=51;; 5) c=201;; esac
        out="$out\033[1;38;5;${c}m${ch}"; i=$((i+1))
      done
      printf "\r%b\033[0m" "$out"; sleep 0.07
    done; printf "\n" ;;

  weather)
    city="$*"
    if command -v curl >/dev/null 2>&1; then
      curl -fsS --max-time 8 "https://wttr.in/${city// /+}?format=3" 2>/dev/null \
        || echo "kos: couldn't reach the weather service (offline?)"
    else echo "kos: curl not found"; exit 1; fi ;;

  tip)
    if command -v kos-tip >/dev/null 2>&1; then exec kos-tip
    else echo "Tip: run 'sudo kos setup' to unlock all the kOS extras."; fi ;;

  auto)
    case "${1:-}" in
      on)  systemctl --user enable --now kos-daynight.timer 2>/dev/null \
             && echo "day/night auto theme: ON" || echo "kos: couldn't enable (is the timer installed?)" ;;
      off) systemctl --user disable --now kos-daynight.timer 2>/dev/null \
             && echo "day/night auto theme: OFF" || echo "kos: couldn't disable" ;;
      ""|status)
        if systemctl --user is-enabled kos-daynight.timer >/dev/null 2>&1; then echo "day/night auto theme: ON"
        else echo "day/night auto theme: OFF  (turn on with: kos auto on)"; fi ;;
      *) echo "usage: kos auto on|off" ;;
    esac ;;

  welcome|oobe)
    if command -v kos-oobe >/dev/null 2>&1; then exec kos-oobe --force
    else echo "kos: welcome wizard not installed (reinstall kos-desktop)"; exit 1; fi ;;

  center|control|cc)
    if command -v kos-control-center >/dev/null 2>&1; then
      exec env GSK_RENDERER=cairo kos-control-center "$@"
    else echo "kos: Control Center not installed (reinstall kos-desktop)"; exit 1; fi ;;

  update|upgrade)
    echo "Updating kOS..."
    sudo apt update && sudo apt install --only-upgrade -y kos-desktop
    echo "Done. You're on kOS $(dpkg-query -W -f='${Version}' kos-desktop 2>/dev/null)." ;;

  site|web)      exec xdg-open "$SITE" ;;
  github|repo)   exec xdg-open "$REPO" ;;
  bugs|issues)   exec xdg-open "$REPO/issues" ;;

  info|fetch)
    if command -v fastfetch >/dev/null 2>&1; then exec fastfetch
    else . /etc/os-release 2>/dev/null; echo "$PRETTY_NAME $(uname -m) — kernel $(uname -r)"; fi ;;

  about)
    . /etc/os-release 2>/dev/null
    printf '%s\n' \
      "kOS${CODE:+ \"$CODE\"}" \
      "Version:  $VERSION${CODE:+   Codename:  $CODE}" \
      "System:   $(uname -m) · kernel $(uname -r)" \
      "Base:     Kali Linux · Desktop: KDE Plasma" \
      "Themes:   lamplight · liquidglass · dark · light" \
      "" \
      "Website:  $SITE" \
      "GitHub:   $REPO" ;;

  version|-v|--version)
    echo "kOS${CODE:+ \"$CODE\"} ($VERSION)" ;;

  help|-h|--help)
    cat <<H
kOS${CODE:+ "$CODE"} (build $VERSION) — usage:

  Setup & look
    sudo kos setup            apply the full kOS look + system tweaks
    kos theme <name>          switch desktop look live:
                                lamplight    warm, lamplit
                                liquidglass  cool frosted gray
                                dark         kOS dark
                                light        kOS light
    kos next                  cycle to the next theme
    kos themes                list the themes
    kos wallpaper <name>      set just the wallpaper
    kos accent <color>        amber|slate|blue|green|purple|red|random
    kos auto on|off           day/night auto theme (warm by day, dark by night)

  Apps
    kos welcome               re-run the first-boot welcome wizard
    kos center                open the kOS Control Center
    kos notify [message]      pop a desktop notification

  Fun
    kos matrix                digital rain
    kos party                 rainbow celebration
    kos weather [city]        weather in your terminal
    kos tip                   a random kOS tip

  System
    kos update                update kOS to the latest version
    kos info                  show system info (fastfetch)
    kos about                 show kOS at a glance
    kos version               show version

  Links
    kos site                  open the kOS website
    kos github                open the kOS repo
    kos bugs                  open the issue tracker
H
    ;;

  *)
    echo "kos: unknown command '$cmd'  (try: kos help)"; exit 1 ;;
esac
